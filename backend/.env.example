# Environment Variables — JopUP Backend

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# ─── JWT Auth ─────────────────────────────────────────────────
# Secret key for signing JWTs (use a long, random string in production)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d


# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Optional rate-limit overrides (defaults: login 10 per 15 min, signup 5 per hour per IP)
# LOGIN_RATE_LIMIT_MAX=10
# SIGNUP_RATE_LIMIT_MAX=5
# Slug of the internal org that holds platform_owner/platform_admin (excluded from tenant metrics)
# PLATFORM_ORG_SLUG=jopup-platform

# ─── Email (platform emails: invitations, etc.) ───────────────
# Provider: "resend" or "console" (logs instead of sending).
# If unset: resend when RESEND_API_KEY is set, otherwise console.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be an address on a domain verified in Resend, e.g. mail.yourdomain.com
# EMAIL_FROM=JopUP <no-reply@mail.yourdomain.com>
# EMAIL_REPLY_TO=support@yourdomain.com
# Frontend base URL used in email links (invitation accept link).
# REQUIRED in production — the server refuses to start without a non-localhost value.
# APP_URL=http://localhost:5173
# Include the raw invitation token in API responses? Default: true outside
# production, false in production.
# EXPOSE_INVITATION_TOKEN=true

# Daily tracker scheduler: checks every minute for trackers that are due.
# Set to "off" on instances that should not send (e.g. a web-only replica).
# Send times use each organisation's timezone (organisation.timezone), so set it at onboarding.
# DAILY_TRACKER_SCHEDULER=on
